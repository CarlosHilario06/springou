# ---------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/springou?schema=public"

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------
# Segredo de assinatura do JWT. Gere um valor forte e único:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Admin criado automaticamente no primeiro start (só se não houver usuário).
# Depois de criado, troque a senha pelo painel e remova estas variáveis.
ADMIN_EMAIL="admin@springou.local"
ADMIN_PASSWORD=""

# ---------------------------------------------------------------
# Frontend (Vite — só variáveis VITE_* chegam ao navegador)
# ---------------------------------------------------------------
VITE_API_URL="http://localhost:3001"

# ---------------------------------------------------------------
# Google Ad Manager
# ---------------------------------------------------------------
# Liga a sincronização automática (cron de hora em hora)
ENABLE_GAM_SYNC="false"
GAM_SYNC_CRON="0 * * * *"

# Credenciais OAuth do GAM, como JSON em uma linha.
# Nunca commite estes valores.
GAM_OAUTH_JSON=""
GAM_TOKEN_JSON=""

# Fallbacks opcionais (o normal é cadastrar pelo painel > Ad Manager)
GAM_NETWORK_CODE=""
GAM_REPORT_ID=""

# ---------------------------------------------------------------
# Pixel padrão (opcional) — usado quando a rota não define um
# ---------------------------------------------------------------
FB_PIXEL_ID=""

# ---------------------------------------------------------------
# Deploy com Docker (docker compose lê este mesmo arquivo)
# ---------------------------------------------------------------
# Domínio que o Caddy vai usar para emitir o certificado HTTPS.
DOMAIN="split.seudominio.com"

# Senha do Postgres que sobe junto no compose. Gere uma forte:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=""

# No deploy com compose o DATABASE_URL é montado automaticamente a partir
# da senha acima — a variável lá em cima só vale para rodar localmente.
